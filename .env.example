# ============================================================
# Django Application Configuration
# ============================================================
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# PostgreSQL Database Configuration
# ============================================================
POSTGRES_DB=learning_intelligence
POSTGRES_USER=lip
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://lip:replace-with-a-strong-database-password@localhost:5432/learning_intelligence

# ============================================================
# CORS & Web Client
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# ============================================================
# JWT Authentication Settings
# ============================================================
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# JWT_SIGNING_KEY=

# ============================================================
# Email Verification & Notifications
# ============================================================
# For local dev, console backend prints emails to backend logs:
#EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
#DEFAULT_FROM_EMAIL=Learning Intelligence Platform <noreply@learningplatform.local>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

EMAIL_HOST_USER=YOUR_GMAIL@gmail.com
EMAIL_HOST_PASSWORD=YOUR_16_CHARACTER_APP_PASSWORD

DEFAULT_FROM_EMAIL=Learning Intelligence Platform <YOUR_GMAIL@gmail.com>

# ============================================================
# Google OAuth / OIDC Configuration
# ============================================================
# Leave unset or empty until real Google OAuth credentials are ready
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ============================================================
# AI & Embedding Providers (Provider-Agnostic)
# ============================================================
# Options: "mock" (for tests / offline dev) or "openai" (for real production AI)
AI_PROVIDER=mock
# When using real AI:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
